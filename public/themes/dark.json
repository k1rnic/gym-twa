      "activeBg": "rgb(23, 26, 31)",
      "colorBorder": "transparent",
      "colorBgContainerDisabled": "transparent",
      "colorTextDisabled": "rgba(255,255,255,0.85)"
    },
    "Select": {
      "colorBgContainerDisabled": "rgb(23, 26, 31)",
      "colorBorder": "transparent"
    },
    "Button": {
      "defaultShadow": "none"
    },
    "Drawer": {
      "colorBgElevated": "rgb(23, 26, 31)"
    },
    "Avatar": {
      "containerSizeLG": 64
    }
